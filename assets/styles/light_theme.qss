/* Premium Modern Light Theme */
QMainWindow, QWidget {
    background-color: #F8F9FA;
    color: #2B2D42;
    font-family: 'Segoe UI', system-ui, sans-serif;
}

/* Ensure the scroll area and its viewport match the background */
QScrollArea, QScrollArea > QWidget > QWidget {
    border: none;
    background-color: #F8F9FA;
}

QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E9ECEF;
    padding: 4px;
}

QToolBar QAction {
    padding: 6px;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    margin-top: 18px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 2px 6px;
    color: #4361EE;
    font-weight: 700;
    font-size: 12px;
    background-color: #FFFFFF;
    border-radius: 4px;
}

QPushButton {
    background-color: #4361EE;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #3F37C9;
}

QPushButton:pressed {
    background-color: #3A0CA3;
}

QTabWidget::pane {
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    background: #FFFFFF;
}

QTabBar::tab {
    background: #F8F9FA;
    color: #6C757D;
    padding: 10px 20px;
    border: 1px solid transparent;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #4361EE;
    border: 1px solid #DEE2E6;
    border-bottom: 1px solid #FFFFFF;
}

QTabBar::tab:hover:!selected {
    background: #E9ECEF;
    color: #2B2D42;
}

QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #F8F9FA;
    color: #2B2D42;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 6px 10px;
}

QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #4361EE;
    background-color: #FFFFFF;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E9ECEF;
    color: #6C757D;
}

/* Specific fix for the Hex Viewer which inherits QWidget */
QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #2B2D42;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
}

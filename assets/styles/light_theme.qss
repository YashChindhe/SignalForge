/* light_theme.qss */
QMainWindow {
    background-color: #f5f5f5;
    color: #121212;
}
QWidget {
    background-color: #f5f5f5;
    color: #121212;
}
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #cccccc;
}
QGroupBox {
    border: 1px solid #aaaaaa;
    border-radius: 4px;
    margin-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
    color: #1976d2;
}
QPushButton {
    background-color: #1976d2;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px;
}
QPushButton:hover {
    background-color: #1565c0;
}
QTabWidget::pane {
    border: 1px solid #ccc;
}
QTabBar::tab {
    background: #e0e0e0;
    color: #444;
    padding: 8px 16px;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #000;
    border-bottom: 2px solid #1976d2;
}
QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #000;
    border: 1px solid #aaa;
    padding: 4px;
}
QScrollArea {
    border: none;
}

/* dark_theme.qss */
QMainWindow {
    background-color: #121212;
    color: #e0e0e0;
}
QWidget {
    background-color: #121212;
    color: #e0e0e0;
}
QToolBar {
    background-color: #1e1e1e;
    border-bottom: 1px solid #333333;
}
QGroupBox {
    border: 1px solid #444444;
    border-radius: 4px;
    margin-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
    color: #90caf9;
}
QPushButton {
    background-color: #0f3460;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px;
}
QPushButton:hover {
    background-color: #1a4f8b;
}
QTabWidget::pane {
    border: 1px solid #333;
}
QTabBar::tab {
    background: #1e1e1e;
    color: #888;
    padding: 8px 16px;
}
QTabBar::tab:selected {
    background: #2a2a2a;
    color: #fff;
    border-bottom: 2px solid #90caf9;
}
QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #2a2a2a;
    color: #fff;
    border: 1px solid #555;
    padding: 4px;
}
QScrollArea {
    border: none;
}
